<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://apple.com">
<plist version="1.0">
<dict>
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>Icon</key>
            <data>
            <!-- Đây là mã ảnh nền Icon, hệ thống Apple sẽ tự gán Logo mặc định từ Web Clip nếu để trống -->
            </data>
            <key>Label</key>
            <string>Thánh Ca AZ</string>
            <key>URL</key>
            <string>https://github.io</string>
            <key>FullScreen</key>
            <false/> <!-- 🚀 CHÌA KHÓA VÀNG: Ép buộc iPhone phải bật ứng dụng Safari gốc có thanh địa chỉ đáy thay vì mở chế độ tàng hình -->
            <key>IgnoreManifestScope</key>
            <true/>
            <key>PayloadDescription</key>
            <string>Shortcut cưỡng ép mở bằng Safari gốc để mở khóa Micro tìm bài hát</string>
            <key>PayloadDisplayName</key>
            <string>Thánh Ca AZ Safari</string>
            <key>PayloadIdentifier</key>
            <string>com.sangankhoai123.thanhcaaz.webclip</string>
            <key>PayloadType</key>
            <string>com.apple.webclip.managed</string>
            <key>PayloadUUID</key>
            <string>a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
        </dict>
    </array>
    <key>PayloadDisplayName</key>
    <string>Cài Đặt Thánh Ca AZ</string>
    <key>PayloadIdentifier</key>
    <string>com.sangankhoai123.thanhcaaz</string>
    <key>PayloadOrganization</key>
    <string>ThanhCaAZ Lab</string>
    <key>PayloadRemovalDisallowed</key>
    <false/>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>f1e2d3c4-b5a6-7f8e-9d0c-1b2a3c4d5e6f</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
</dict>
</plist>
